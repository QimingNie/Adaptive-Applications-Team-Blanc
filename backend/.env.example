APP_NAME=Smart Inbox API
DATABASE_URL=sqlite:///./smart_inbox.db

# Google OAuth (Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must match Google Console OAuth redirect URI exactly
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Frontend URL to receive OAuth result
FRONTEND_OAUTH_DONE_URI=http://localhost:5173/
