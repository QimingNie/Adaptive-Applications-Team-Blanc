APP_NAME=Smart Inbox API
DATABASE_URL=sqlite:///./smart_inbox.db

# Google OAuth (Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must match Google Console OAuth redirect URI exactly
GOOGLE_REDIRECT_URI=http://127.0.0.1:8010/api/auth/google/callback

# Frontend URL to receive OAuth result
FRONTEND_OAUTH_DONE_URI=http://localhost:5173/

# Optional busy-summary LLM settings
SUMMARY_PROVIDER=openai
SUMMARY_MODEL=minimax/minimax-m2.5:free
SUMMARY_API_BASE_URL=https://openrouter.ai/api/v1
SUMMARY_API_KEY= your-openrouter-api-key
SUMMARY_TIMEOUT_SECONDS=12
SUMMARY_MAX_INPUT_CHARS=1800
SUMMARY_MIN_LLM_CHARS=280
